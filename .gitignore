# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# room store safety-net mirror
.room-state.json
.deck-state.json
.decision-room-state.json
# The store writes to a temp file and renames it; a server killed mid-write leaves the temp behind.
.room-state.json.*.tmp
.decision-room-state.json.*.tmp

# isolated dev worktrees
.worktrees/
