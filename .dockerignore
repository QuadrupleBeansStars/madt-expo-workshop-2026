# Keep the build context small and keep local room state out of the image entirely — a
# `.room-state.json` baked into a container would restore a stale game on every cold start.
node_modules
.next
.git
.worktrees
.superpowers
npm-debug.log*
*.tmp

# live room state (both apps)
.room-state.json
.decision-room-state.json
*.state.json

# not needed at runtime
docs
scripts
coverage
**/*.test.ts
**/*.test.tsx
vitest.config.ts
vitest.setup.ts
README.md
